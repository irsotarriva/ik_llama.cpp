# LFM2-24B-A2B (measured: Q4_K_M). Every swap costs this model much more than Qwen:
# keep it exact and get the speed from memory (LA_RESIDENT_FRAC, LA_GPU_FRAC).
# Generated on 2026-10-26 from measured quality grids (see README.md). A level allows
# that much KL above exact routing on every model measured, at 15% and 40% resident;
# 'saved' is the share of exact routing's disk reads avoided, worst case.
match arch=lfm2moe n_expert=64
default exact
LA_PROFILE=profiles/lfm2-24b-a2b.f32

[exact]
# KL budget 0: +0.0000 KL, 0% of reads saved (worst case); at 40% resident +0.0000, 0%
LA_BETA=0

[near]
# KL budget 0.005: +0.0000 KL, 0% of reads saved (worst case); at 40% resident +0.0000, 0%
LA_BETA=0

[balanced]
# KL budget 0.02: +0.0000 KL, 0% of reads saved (worst case); at 40% resident +0.0000, 0%
LA_BETA=0

[fast]
# KL budget 0.1: +0.0000 KL, 0% of reads saved (worst case); at 40% resident +0.0000, 0%
LA_BETA=0
